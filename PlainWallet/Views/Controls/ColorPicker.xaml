<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cp="clr-namespace:Maui.ColorPicker;assembly=Maui.ColorPicker"
             x:Class="PlainWallet.Views.Controls.ColorPicker">
    <Border
        Padding="0"
        BackgroundColor="Lightblue"
        Stroke="DarkBlue"
        StrokeThickness="1">
        <VerticalStackLayout>
            <cp:ColorPicker
                x:Name="subColorPicker"
                ColorFlowDirection="Horizontal"
                ColorSpectrumStyle="TintToHueToShadeStyle"
                PointerRingBorderUnits="0.3"
                PointerRingDiameterUnits="0.7"
                HeightRequest="150"
                PickedColor="{Binding SelectedColor, Mode=TwoWay}"   
                Margin="0,0"/>
            <FlexLayout x:Name="colorPalette" Direction="Row" Wrap="Wrap" Margin="0,0" AlignItems ="Center" JustifyContent="Center">
                
            </FlexLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>