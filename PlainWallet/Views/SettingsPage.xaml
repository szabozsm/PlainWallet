<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlainWallet.Views.SettingsPage"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Settings"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
            
            <Frame Padding="15" CornerRadius="10" BorderColor="LightGray">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Dummy Property"
                           FontAttributes="Bold" />
                    <Entry x:Name="DummyPropertyEntry"
                           Text="{Binding DummyProperty}"
                           Placeholder="Enter dummy property value" />
                </VerticalStackLayout>
            </Frame>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Button x:Name="ApplyButton"
                        Text="Apply"
                        Clicked="OnApplyClicked"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        TextColor="White" />
                
                <Button x:Name="CancelButton"
                        Text="Cancel"
                        Clicked="OnCancelClicked"
                        BackgroundColor="Gray"
                        TextColor="White" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
