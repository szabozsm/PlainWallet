<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mcp="clr-namespace:PlainWallet.Views.Controls"
             x:Class="PlainWallet.Views.CardEditorPage"
             Title="New card">

       <ScrollView>
              <VerticalStackLayout Padding="20"
                                   Spacing="16">

                     <Label Text="Name"
                            FontAttributes="Bold"/>
                     <Entry x:Name="NameEntry"
                            Placeholder="Card or store name"
                            Text="{Binding Name, Mode=TwoWay}"/>

                     <Label Text="Card number"
                            FontAttributes="Bold"/>
                     <Grid ColumnDefinitions="*,Auto"
                           ColumnSpacing="8">
                            <Entry x:Name="CardNumberEntry"
                                   Placeholder="e.g. 1234 5678 9012"
                                   Text="{Binding CardNumber, Mode=TwoWay}"
                                   VerticalOptions="Center"
                                   Grid.Column="0"/>
                            <ImageButton
                                   Grid.Column="1"
                                   WidthRequest="50"
                                   HeightRequest="40"
                                   Source="barcode_scan.svg"
                                   Clicked="OnScanBarcodeClicked"
                                   BackgroundColor="{StaticResource Primary}"
                                   CornerRadius="25"
                                   Padding="12"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                     </Grid>

                     <Label Text="Barcode type"
                            FontAttributes="Bold"/>
                     <Picker x:Name="BarcodeTypePicker"
                             Title="Pick barcode type"
                             ItemsSource="{Binding BarcodeTypeOptions}"
                             ItemDisplayBinding="{Binding DisplayName}"
                             SelectedItem="{Binding SelectedBarcodeType, Mode=TwoWay}"/>

                     <Label Text="Logo"
                            FontAttributes="Bold"/>
                     <HorizontalStackLayout Spacing="12"
                                            VerticalOptions="Center">

                            <Border WidthRequest="96"
                                    HeightRequest="96"
                                    Padding="6"
                                    Margin="0,6"
                                    Stroke="Transparent"
                                    BackgroundColor="Transparent">
                                   <Image x:Name="LogoPreview"
                                          Aspect="AspectFit"/>
                            </Border>

                            <Button  Text="Select Logo"
                                     Clicked="OnSelectLogoClicked"
                                     BackgroundColor="{StaticResource Primary}"/>
                     </HorizontalStackLayout>
                     <mcp:ColorPicker
                            x:Name="ColorPicker"
                            SelectedColor="{Binding SelectedColor0, Mode=TwoWay}"
                            Margin="0,5"/>

                     <Label Text="Notes"
                            FontAttributes="Bold"/>
                     <Editor x:Name="NotesEditor"
                             Placeholder="Optional notes"
                             HeightRequest="80"
                             Text="{Binding Notes, Mode=TwoWay}"/>
                     <Button
                            WidthRequest="200"
                                   BackgroundColor="Red"
                                   TextColor="white"
                            Text="Delete"
                            Clicked="OnDeleteClicked"/>
              </VerticalStackLayout>
       </ScrollView>

</ContentPage>
