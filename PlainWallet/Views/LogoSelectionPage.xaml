<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlainWallet.Views.LogoSelectionPage"
             Title="Select Logo">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Text="Choose a logo" FontAttributes="Bold" />

        <Entry Grid.Row="1" x:Name="FilterEntry" Placeholder="Filter by filename" TextChanged="OnFilterTextChanged" />

        <CollectionView Grid.Row="2"
                        x:Name="LogosCollection"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged"
                         ItemsLayout="VerticalGrid, 2"
                        ItemSizingStrategy="MeasureAllItems">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="0,6" Stroke="LightGray" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Grid>
                            <Image Source="{Binding .}"
                                   Aspect="AspectFit"
                                   HeightRequest="140"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" x:Name="UrlEntry" Placeholder="Enter image URL" HorizontalOptions="Fill" TextChanged="OnUrlTextChanged" />
            <Button Grid.Column="1" Text="Use URL" Clicked="OnUseUrlClicked" />
        </Grid>

        <Border Grid.Row="4" Padding="6" Margin="0,6" Stroke="Transparent" BackgroundColor="Transparent">
            <Image x:Name="UrlPreview" Aspect="AspectFit" HeightRequest="140" HorizontalOptions="Fill" />
        </Border>

        <HorizontalStackLayout Grid.Row="5" Spacing="12">
            <Button Text="Browse for image" Clicked="OnBrowseClicked" />
            <Button Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="LightGray" />
        </HorizontalStackLayout>
    </Grid>

</ContentPage>
