<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlainWallet.Views.CredentialsQrCodePage"
             Title="Share credentials">
    <Grid Padding="24"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="20">
        <Label Grid.Row="0"
               Text="Scan this QR code to transfer your ExtendsClass settings."
               HorizontalTextAlignment="Center"
               VerticalOptions="Center"/>
        <Image x:Name="CredentialsQrImage"
               Grid.Row="1"
               WidthRequest="320"
               HeightRequest="320"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               SemanticProperties.Description="QR code containing ExtendsClass credentials"/>
        <Label Grid.Row="2"
               Text="Anyone who scans this code can access your cloud data. Only show it to someone you trust."
               FontSize="13"
               HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"/>
    </Grid>
</ContentPage>
