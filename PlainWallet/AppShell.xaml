<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PlainWallet.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PlainWallet.Views"
    xmlns:local="clr-namespace:PlainWallet"
    Shell.FlyoutBehavior="Flyout"
    Title="PlainWallet">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage"/>

    <MenuItem Text="Settings"
            IconImageSource="settings.svg"
            Clicked="OnSettingsClicked"/>



    <FlyoutItem Title="Export"
            Icon="export.svg">

        <ShellContent
            Title="Export"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="ExportPage"/>
    </FlyoutItem>

    <FlyoutItem Title="Import"
            Icon="import_data.svg">

        <ShellContent
            Title="Import"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="ImportPage"/>
    </FlyoutItem>

</Shell>
