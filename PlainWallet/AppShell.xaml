<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PlainWallet.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PlainWallet.Views"
    xmlns:local="clr-namespace:PlainWallet"
    Shell.FlyoutBehavior="Flyout"
    Title="PlainWallet">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage"/>

    <MenuItem Text="Settings"
              IconImageSource="settings.svg"
              Clicked="OnSettingsClicked"/>

    <MenuItem Text="Export"
              IconImageSource="export.svg"
              Clicked="OnExportClicked"/>

    <MenuItem Text="Import"
              IconImageSource="import_data.svg"
              Clicked="OnImportClicked"/>

</Shell>
