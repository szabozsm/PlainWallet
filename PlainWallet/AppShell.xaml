                <Grid ColumnDefinitions="auto,*"
                        Margin="0,80">
                    <Image Grid.Column="0"
                           Source="database_delete.svg"
                           Margin="16,8,28,0"
                           HeightRequest="32"/>
                    <Label Grid.Column="1"
                           Text="{Binding Text}"
                           TextColor="Red"
                           
